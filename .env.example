# Bootstrap — creates first AdminUser when table is empty (one-time)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Optional admin session TTL in seconds (default 28800 = 8h)
# ADMIN_SESSION_TTL_SECONDS=28800
# Stay signed in (rememberMe) — max 7776000 (90 days); default 2592000 (30d)
# ADMIN_SESSION_REMEMBER_TTL_SECONDS=2592000

# Database — single encrypted libSQL file (see docs/database.md)
DATABASE_URL=file:../data/nestidp.db
# At-rest encryption key (REQUIRED in production). Generate e.g. `openssl rand -hex 32`.
# Provide inline OR via DATABASE_ENCRYPTION_KEY_FILE (a mounted secret), not both.
# DATABASE_ENCRYPTION_KEY=
# DATABASE_ENCRYPTION_KEY_FILE=/run/secrets/db_encryption_key

# Required secrets — keep stable across restarts in production
SESSION_SECRET=change-me-min-16-chars
# ENCRYPTION_KEY must stay stable — rotation invalidates stored API Bearer tokens
ENCRYPTION_KEY=change-me-min-16-chars

# IdP public base URL (used for bootstrap IdpSettings.entityId)
IDP_BASE_URL=http://localhost:3000

# Optional identity sync tuning
# SYNC_HTTP_TIMEOUT_MS=30000
# SYNC_STALE_RUN_MINUTES=30
# SYNC_MAX_USERS_PER_RUN=10000

# Optional scheduled-sync tuning (Prompt 32) — scheduling is opt-in per connection and off by default
# SYNC_SCHEDULER_TICK_MS=30000          # tick interval; 0 disables the in-process scheduler entirely
# SYNC_SCHEDULE_MIN_INTERVAL_MINUTES=5  # reject cron schedules that fire more often than this
# SYNC_SCHEDULE_JITTER_MAX_SECONDS=30   # spread same-cron connections; 0 = exact run times
# SYNC_SCHEDULE_FAILURE_AUTOPAUSE_THRESHOLD=0  # N consecutive failures auto-pause; 0 = never
# SYNC_SCHEDULE_BOOT_OVERDUE_GRACE_MINUTES=0   # run-on-boot only if overdue by <= this; 0 = never

# Optional OAuth 2.0 Client Credentials tuning (API connection auth)
# OAUTH_TOKEN_HTTP_TIMEOUT_MS=30000
# OAUTH_TOKEN_REFRESH_SKEW_SECONDS=30
# OAUTH_TOKEN_MIN_TTL_SECONDS=30
# OAUTH_TOKEN_MAX_TTL_SECONDS=86400

# Optional outbound HTTP proxy tuning (per-connection proxy is configured in the admin console)
# PROXY_CONNECT_TIMEOUT_MS=5000          # ProxyAgent connect timeout (fast-fail a dead proxy); 100..60000

# Optional automatic certificate rotation (Prompt 34) — opt-in per cert in the admin console, off by default.
# CERT_ROTATION_SCHEDULER_TICK_MS=3600000   # 0 disables the auto-rotation scheduler (manual only)
# CERT_ROTATION_LEAD_DAYS=30                # auto-start when active cert expires within N days
# CERT_ROTATION_OVERLAP_DAYS=7              # auto-complete after the pending cert has been published N days
# CERT_ROTATION_VALIDITY_DAYS=365           # validity of auto-generated rotation certs
# CERT_ROTATION_NOTIFY_LEAD_DAYS=45         # "due soon" pre-notification lead
# CERT_ROTATION_JITTER_MAX_SECONDS=0        # random spread before auto-start; 0 = exact
# CERT_ROTATION_BOOT_GRACE_HOURS=0          # on boot, act immediately only if expiring within N hours
# CERT_ROTATION_FAILURE_AUTODISABLE_THRESHOLD=5  # auto-disable after N consecutive failures; 0 = never
# CERT_ROTATION_DRY_RUN=false               # evaluate + audit without mutating
# Per-cert overrides: CERT_ROTATION_{SIGNING,ENCRYPTION}_{LEAD,OVERLAP}_DAYS

# Optional SAML tuning (Prompt 07)
# SAML_ASSERTION_TTL_SECONDS=300
# SAML_SESSION_TTL_SECONDS=900
# SAML_CLOCK_SKEW_SECONDS=120
# SAML_METADATA_INCLUDE_ACS=true
# SAML_SESSION_CLEANUP_INTERVAL_MS=0

# Optional end-user (SAML login) session and rate limits
# END_USER_SESSION_TTL_SECONDS=3600
# END_USER_LOGIN_RATE_LIMIT_MAX=10
# END_USER_LOGIN_RATE_LIMIT_WINDOW_MS=900000
# END_USER_LOGIN_RATE_LIMIT_USERNAME_MAX=5
# END_USER_LOGIN_RATE_LIMIT_USERNAME_WINDOW_MS=900000

# Reverse proxy (set true when behind TLS-terminating load balancer)
# TRUST_PROXY=false

# Persistent audit log retention (see docs/database.md)
# AUDIT_RETENTION_DAYS=90
# AUDIT_CLEANUP_INTERVAL_MS=86400000

# Rate limit on POST /api/admin/admin-users
# ADMIN_USER_CREATE_RATE_LIMIT_MAX=5
# ADMIN_USER_CREATE_RATE_LIMIT_WINDOW_MS=900000

# Docker entrypoint only — migrate and exit (init containers)
# MIGRATE_ONLY=0

NODE_ENV=development
