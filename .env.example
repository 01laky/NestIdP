# NestIdP — local environment (copy to .env)
# Never commit real secrets.

# PostgreSQL (docker-compose exposes 5432)
DATABASE_URL=postgresql://nestidp:nestidp@localhost:5432/nestidp

# Session cookie signing (use a long random string in production)
SESSION_SECRET=change-me-session-secret

# Encrypts API credentials and IdP private keys at rest
ENCRYPTION_KEY=change-me-encryption-key

# Public base URL of this IdP deployment
IDP_BASE_URL=http://localhost:3000

# development | production | test
NODE_ENV=development

# API listen port
PORT=3000

# Bootstrap placeholder — first admin seeding in a later prompt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Vite dev server proxy target (optional; default http://localhost:3000)
# VITE_API_PROXY_TARGET=http://localhost:3000
