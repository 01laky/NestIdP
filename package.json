{
	"name": "nest-idp",
	"version": "1.0.1",
	"private": true,
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=18",
		"pnpm": ">=9"
	},
	"scripts": {
		"postinstall": "pnpm --filter @nestidp/shared build && pnpm --filter @nestidp/api prisma:generate",
		"dev": "pnpm --filter @nestidp/shared build && concurrently -n api,web -c blue,green \"pnpm --filter @nestidp/api dev\" \"pnpm --filter @nestidp/web dev\"",
		"build": "pnpm --filter @nestidp/shared build && pnpm --filter @nestidp/web build && pnpm --filter @nestidp/api build",
		"lint": "eslint . && pnpm --filter @nestidp/api lint && pnpm --filter @nestidp/web lint",
		"test": "pnpm --filter @nestidp/shared test && pnpm --filter @nestidp/api test && pnpm --filter @nestidp/web test",
		"format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
		"diagrams:build": "node scripts/build-diagrams.mjs",
		"diagrams:check": "node scripts/check-diagrams.mjs",
		"setup:githooks": "sh scripts/setup-githooks.sh",
		"db:migrate": "pnpm --filter @nestidp/api prisma:migrate",
		"db:migrate:deploy": "pnpm --filter @nestidp/api prisma:migrate:deploy"
	},
	"devDependencies": {
		"@eslint/js": "^9.22.0",
		"concurrently": "^9.1.2",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"globals": "^16.0.0",
		"prettier": "^3.5.3",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.1"
	}
}
