{
	"name": "nest-idp",
	"version": "1.20.3",
	"private": true,
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=18",
		"pnpm": ">=9"
	},
	"scripts": {
		"postinstall": "pnpm --filter @nestidp/shared build && pnpm --filter @nestidp/api prisma:generate",
		"dev": "pnpm --filter @nestidp/shared build && concurrently -k -n shared,api,web -c magenta,blue,green \"pnpm --filter @nestidp/shared exec tsc -w -p tsconfig.json --preserveWatchOutput\" \"pnpm --filter @nestidp/api dev\" \"pnpm --filter @nestidp/web dev\"",
		"docker:dev": "docker compose -f deploy/docker-compose.dev.yml --env-file deploy/.env.docker.dev up --build",
		"docker:dev:down": "docker compose -f deploy/docker-compose.dev.yml --env-file deploy/.env.docker.dev down",
		"docker:dev:reset": "docker compose -f deploy/docker-compose.dev.yml --env-file deploy/.env.docker.dev down -v",
		"docker:dev:logs": "docker compose -f deploy/docker-compose.dev.yml logs -f",
		"docker:dev:shell": "docker compose -f deploy/docker-compose.dev.yml exec nestidp-dev sh",
		"docker:prod": "docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.docker.prod up --build -d",
		"docker:prod:down": "docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.docker.prod down",
		"docker:prod:reset": "docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.docker.prod down -v",
		"docker:prod:logs": "docker compose -f deploy/docker-compose.prod.yml logs -f",
		"docker:prod:migrate": "docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.docker.prod run --rm nestidp sh -c \"MIGRATE_ONLY=1 node dist/main.js\"",
		"build": "pnpm --filter @nestidp/shared build && pnpm --filter @nestidp/web build && pnpm --filter @nestidp/api build",
		"lint": "eslint . && node scripts/check-config-access.mjs && pnpm --filter @nestidp/shared lint && pnpm --filter @nestidp/api lint && pnpm --filter @nestidp/web lint",
		"test": "node scripts/run-monorepo-tests.mjs",
		"test:cleanup": "node scripts/cleanup-test-processes.mjs",
		"format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
		"docs:screenshots": "pnpm build && pnpm --filter @nestidp/web docs:screenshots",
		"diagrams:build": "node scripts/build-diagrams.mjs",
		"diagrams:check": "node scripts/check-diagrams.mjs",
		"check:i18n-keys": "node scripts/check-i18n-keys.mjs",
		"setup:githooks": "sh scripts/setup-githooks.sh",
		"db:new-migration": "pnpm --filter @nestidp/api db:new-migration",
		"db:migrate:deploy": "pnpm --filter @nestidp/api db:migrate:deploy"
	},
	"devDependencies": {
		"@eslint/js": "^9.22.0",
		"concurrently": "^9.1.2",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"globals": "^16.0.0",
		"prettier": "^3.5.3",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.1"
	}
}
