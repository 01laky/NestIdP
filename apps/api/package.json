{
	"name": "@nestidp/api",
	"version": "1.2.3",
	"private": true,
	"scripts": {
		"dev": "nest start --watch",
		"build": "nest build",
		"start": "node dist/main.js",
		"start:prod": "node dist/main.js",
		"lint": "tsc -p tsconfig.json --noEmit",
		"test": "jest && jest --config ./test/jest-e2e.config.js",
		"test:e2e": "jest --config ./test/jest-e2e.config.js",
		"test:watch": "jest --watch",
		"prisma:prepare": "node scripts/sync-prisma-provider.mjs",
		"prisma:generate": "pnpm prisma:prepare && prisma generate",
		"prisma:migrate": "pnpm prisma:prepare && prisma migrate dev",
		"prisma:migrate:deploy": "pnpm prisma:prepare && prisma migrate deploy"
	},
	"prisma": {
		"seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
	},
	"dependencies": {
		"@nestidp/shared": "workspace:*",
		"@nestjs/common": "^11.0.12",
		"@nestjs/config": "^4.0.1",
		"@nestjs/core": "^11.0.12",
		"@nestjs/platform-express": "^11.0.12",
		"@nestjs/serve-static": "^5.0.3",
		"@prisma/client": "^6.5.0",
		"@xmldom/xmldom": "^0.9.10",
		"bcrypt": "^6.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cookie-parser": "^1.4.7",
		"helmet": "^8.1.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"xml-crypto": "^6.0.1",
		"xmlbuilder2": "^4.0.3",
		"xpath": "^0.0.34"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.5",
		"@nestjs/schematics": "^11.0.2",
		"@nestjs/testing": "^11.0.12",
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.1",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.13.10",
		"@types/supertest": "^6.0.2",
		"dotenv": "^16.4.7",
		"jest": "^29.7.0",
		"prisma": "^6.5.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.6",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.2"
	}
}
