{
	"name": "@nestidp/api",
	"version": "1.18.1",
	"private": true,
	"scripts": {
		"dev": "node scripts/run-dev.mjs",
		"build": "nest build",
		"start": "node dist/main.js",
		"start:prod": "node dist/main.js",
		"lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
		"pretest": "node ../../scripts/cleanup-test-processes.mjs",
		"posttest": "node ../../scripts/cleanup-test-processes.mjs",
		"test": "node scripts/run-jest-tests.mjs",
		"test:e2e": "jest --config ./test/jest-e2e.config.js",
		"test:watch": "jest --watch",
		"prisma:generate": "prisma generate",
		"db:new-migration": "node scripts/author-migration.mjs",
		"db:migrate:deploy": "node scripts/db-cli.mjs migrate",
		"db:rekey": "node scripts/db-cli.mjs rekey",
		"db:backup": "node scripts/db-cli.mjs backup",
		"db:dump": "node scripts/db-cli.mjs dump",
		"db:restore": "node scripts/db-cli.mjs restore"
	},
	"prisma": {
		"seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
	},
	"dependencies": {
		"@libsql/client": "^0.17.3",
		"@nestidp/shared": "workspace:*",
		"@nestjs/common": "^11.0.12",
		"@nestjs/config": "^4.0.1",
		"@nestjs/core": "^11.0.12",
		"@nestjs/platform-express": "^11.0.12",
		"@nestjs/serve-static": "^5.0.3",
		"@prisma/adapter-libsql": "6.19.3",
		"@prisma/client": "^6.5.0",
		"@xmldom/xmldom": "^0.9.10",
		"bcrypt": "^6.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cookie-parser": "^1.4.7",
		"cron-parser": "^5.5.0",
		"cuid": "^3.0.0",
		"express": "^5.0.1",
		"helmet": "^8.1.0",
		"kysely": "^0.27.6",
		"mysql2": "^3.22.5",
		"pg": "^8.21.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"undici": "^6",
		"xml-crypto": "^6.0.1",
		"xmlbuilder2": "^4.0.3",
		"xpath": "^0.0.34"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.1",
		"@nestjs/cli": "^11.0.5",
		"@nestjs/schematics": "^11.0.2",
		"@nestjs/testing": "^11.0.12",
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.1",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.13.10",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^6.0.2",
		"dotenv": "^16.4.7",
		"jest": "^29.7.0",
		"prisma": "^6.5.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.6",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.2"
	}
}
