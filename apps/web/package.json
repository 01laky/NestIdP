{
	"name": "@nestidp/web",
	"version": "1.4.4",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "tsc -b --noEmit",
		"pretest": "node ../../scripts/cleanup-test-processes.mjs",
		"posttest": "node ../../scripts/cleanup-test-processes.mjs",
		"test": "vitest run",
		"test:e2e:visual": "playwright test",
		"test:e2e:visual:update": "playwright test --update-snapshots",
		"test:e2e:ci": "playwright test e2e/responsive-shell.spec.ts e2e/admin-login-remember.spec.ts e2e/admin-confirm-dialog.spec.ts --grep-invert WEB-RSP-31"
	},
	"dependencies": {
		"@nestidp/shared": "workspace:*",
		"@tanstack/react-table": "^8.21.2",
		"i18next": "^26.3.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-i18next": "^17.0.8",
		"react-router-dom": "^7.4.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.51.1",
		"@testing-library/react": "^16.2.0",
		"@types/react": "^18.3.19",
		"@types/react-dom": "^18.3.5",
		"@vitejs/plugin-react": "^4.3.4",
		"jsdom": "^26.0.0",
		"typescript": "^5.8.2",
		"vite": "^6.2.2",
		"vitest": "^3.0.9"
	}
}
