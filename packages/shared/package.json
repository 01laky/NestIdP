{
	"name": "@nestidp/shared",
	"version": "1.20.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"pretest": "node ../../scripts/cleanup-test-processes.mjs",
		"posttest": "node ../../scripts/cleanup-test-processes.mjs",
		"test": "vitest run",
		"lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
	},
	"devDependencies": {
		"typescript": "^5.8.2",
		"vitest": "^3.0.9"
	},
	"dependencies": {
		"cron-parser": "^5.5.0"
	}
}
