flowchart LR
    subgraph schedulers["In-process schedulers (single instance)"]
        SS["SyncSchedulerService\nSYNC_SCHEDULER_TICK_MS\n(default 30 s)"]
        CS["CertRotationSchedulerService\nCERT_ROTATION_SCHEDULER_TICK_MS\n(default 1 h)"]
