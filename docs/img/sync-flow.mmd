flowchart TD
	START(["Operator triggers sync"])
	CONFIG["ApiConnection\nbaseUrl + encrypted token"]
	AUTH["Bearer auth to external API"]
	USERS["GET /users → upsert users + password hashes"]
	GROUPS["GET /users/:id/groups → upsert memberships"]
	ROLES["GET /users/:id/roles → upsert roles"]
	LOG["SyncLog · status · counts · errors"]
	END(["Local identity store ready for login"])

	START --> CONFIG --> AUTH --> USERS --> GROUPS --> ROLES --> LOG --> END

	classDef step fill:#134e4a,stroke:#2dd4bf,stroke-width:2px,color:#f0fdfa
	classDef io fill:#1e3a5f,stroke:#60a5fa,stroke-width:2px,color:#eff6ff

	class CONFIG,AUTH,USERS,GROUPS,ROLES,LOG step
	class START,END io
