flowchart TD
	START(["Operator triggers sync"])
	CONFIG["ApiConnection\nbaseUrl + token + apiContractConfig"]
	RESOLVE["Resolve contract\n(v1 defaults when null)"]
	AUTH["Resolve credential + extra headers\nBearer token OR OAuth2 access token (cached)"]
	USERS["GET usersPath (+ pagination/envelope)\n→ map fields → upsert users"]
	MEMBER{"membershipSource?"}
	EMBEDDED["Read groups/roles\nfrom the user payload"]
	ENDPOINT["GET userGroupsPath/userRolesPath\n(bounded concurrency)"]
	APPLY["Map + upsert groups/roles"]
	LOG["SyncLog · counts · errors\n(skip vs fail per row)"]
	END(["Local identity store ready for login"])

	START --> CONFIG --> RESOLVE --> AUTH --> USERS --> MEMBER
	MEMBER -->|embedded| EMBEDDED --> APPLY
	MEMBER -->|endpoint| ENDPOINT --> APPLY
	APPLY --> LOG --> END

	classDef step fill:#134e4a,stroke:#2dd4bf,stroke-width:2px,color:#f0fdfa
	classDef io fill:#1e3a5f,stroke:#60a5fa,stroke-width:2px,color:#eff6ff
	classDef decision fill:#3f2d12,stroke:#f59e0b,stroke-width:2px,color:#fffbeb

	class CONFIG,RESOLVE,AUTH,USERS,EMBEDDED,ENDPOINT,APPLY,LOG step
	class MEMBER decision
	class START,END io
