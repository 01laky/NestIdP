flowchart TB
	REQ(["Incoming HTTP request"])

	REQ --> HEALTH{"/health or /ready?"}
	HEALTH -->|yes| HEALTH_API["HealthController"]

	HEALTH -->|no| API{"/api/* ?"}
	API -->|"/api/admin/auth/*"| ADMIN_AUTH["Admin auth · login/logout/me/change-password"]
	API -->|"/api/admin/api-connections/*"| API_CONN["API connections CRUD + test"]
	API -->|"/api/admin/sync/*"| SYNC_API["Identity sync trigger + logs"]
	API -->|"/api/admin/sp-connections/*"| SP_API["SP connections CRUD + ACS test"]
	API -->|"/api/admin/idp/*"| IDP_API["IdP settings + metadata URL"]
	API -->|"/api/admin/identity/*"| IDENTITY_API["Synced users/groups/roles browse"]
	API -->|"/api/admin/admin-users/*"| ADM_USERS_API["Operator accounts CRUD"]
	API -->|"/api/admin/audit-events/*"| AUDIT_API["Audit log list + export"]
	API -->|"/api/admin"| DASH_API["Admin dashboard JSON"]
	API -->|"/api/auth/*"| END_USER_AUTH["End-user login · session · complete-sso"]

	API -->|no| SAML{"/saml/* ?"}
	SAML -->|yes| SAML_API["SamlController · metadata + SSO"]

	SAML -->|no| LOGIN{"/login ?"}
	LOGIN -->|yes| SPA_LOGIN["React SAML login page"]

	LOGIN -->|no| ADMIN{"/admin/* ?"}
	ADMIN -->|"/admin/login"| SPA_ADMIN_LOGIN["React operator login"]
	ADMIN -->|"/admin/audit"| SPA_AUDIT["Audit log"]
	ADMIN -->|"/admin/settings/admins"| SPA_ADMINS["Admin accounts"]
	ADMIN -->|"/admin/settings/idp"| SPA_IDP["IdP settings"]
	ADMIN -->|"/admin/api-connections/*"| SPA_API_CONN["API connections UI"]
	ADMIN -->|"/admin/sp-connections/*"| SPA_SP["SP connections UI"]
	ADMIN -->|"/admin/identity/*"| SPA_IDENTITY["Identity browse"]
	ADMIN -->|other /admin/*| SPA_ADMIN["React admin SPA shell"]

	ADMIN -->|no| STATIC["Static assets / SPA fallback"]

