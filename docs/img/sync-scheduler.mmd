flowchart TD
	TICK(["Scheduler tick (SYNC_SCHEDULER_TICK_MS)"])
	LOAD["Load enabled, non-paused, non-local\nconnections where nextRunAt <= now"]
	DUE{"any due?"}
	IDLE(["Wait for next tick"])
	INPROG{"sync already running?\n(stale run = reclaimable)"}
	SKIP["Skip · audit sync_scheduled_run_skipped\nleave nextRunAt (retry next tick)"]
	ADVANCE["Advance nextRunAt to next future slot\n(+ jitter, no catch-up) · set lastScheduledRunAt"]
	TRIGGER["triggerSync(triggerSource='scheduled')\nsystem actor · dry-run if configured"]
	RESULT{"result?"}
	OK["Clear backoff · lastScheduledRunStatus=SUCCESS"]
	FAIL["Increment failures · scheduleLastError\naudit sync_scheduled_run_failed · notifier"]
	AUTOPAUSE{"failures >= threshold?"}
	PAUSED["Auto-pause · scheduleAutoPausedAt\naudit sync_schedule_auto_paused"]

	TICK --> LOAD --> DUE
	DUE -->|no| IDLE
	DUE -->|yes, per connection| INPROG
	INPROG -->|yes| SKIP
	INPROG -->|no| ADVANCE --> TRIGGER --> RESULT
	RESULT -->|SUCCESS| OK
	RESULT -->|FAILED| FAIL --> AUTOPAUSE
	AUTOPAUSE -->|yes| PAUSED
	AUTOPAUSE -->|no| IDLE
	OK --> IDLE
	SKIP --> IDLE
	PAUSED --> IDLE

	classDef step fill:#134e4a,stroke:#2dd4bf,stroke-width:2px,color:#f0fdfa
	classDef io fill:#1e3a5f,stroke:#60a5fa,stroke-width:2px,color:#eff6ff
	classDef decision fill:#3f2d12,stroke:#f59e0b,stroke-width:2px,color:#fffbeb

	class LOAD,SKIP,ADVANCE,TRIGGER,OK,FAIL,PAUSED step
	class DUE,INPROG,RESULT,AUTOPAUSE decision
	class TICK,IDLE io
