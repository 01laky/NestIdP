# =============================================================================
# NestIdP — Development environment template
# =============================================================================
# PRE-FILLED WITH DUMMY VALUES — copy to deploy/.env.docker.dev and run immediately.
# DO NOT use these values in production.
# Used by: pnpm docker:dev (docker-compose.dev.yml)
# =============================================================================

SESSION_SECRET=dev-session-secret-not-for-production
ENCRYPTION_KEY=dev-encryption-key-not-for-production
DATABASE_ENCRYPTION_KEY=dev-db-encryption-key-not-for-prod

ADMIN_USERNAME=admin
ADMIN_PASSWORD=devpassword123

# Vite dev server is the entry point in dev mode (proxies /api and /saml to the API).
IDP_BASE_URL=http://localhost:5173

TRUST_PROXY=false
MIGRATE_ONLY=0

# Vite proxy target — the API runs on port 3000 inside the same container.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# --- Mock identity API (mock-app/ at repo root) ---
# Start with: cd mock-app && pnpm start  →  http://localhost:4010  (token: mock-sync-dev-token)
# The dev container reaches the host via extra_hosts (localhost → host-gateway), so use
# baseUrl http://localhost:4010 in the admin console API connection form.
# Uncomment to enable the scheduled-sync tick so connections with a cron schedule run automatically:
# SYNC_SCHEDULER_TICK_MS=30000

# --- Audit log ---
AUDIT_RETENTION_DAYS=90
AUDIT_CLEANUP_INTERVAL_MS=86400000

# --- Admin user create rate limit ---
ADMIN_USER_CREATE_RATE_LIMIT_MAX=5
ADMIN_USER_CREATE_RATE_LIMIT_WINDOW_MS=900000

# --- Scheduled sync ---
# SYNC_SCHEDULER_TICK_MS=30000
# SYNC_SCHEDULE_MIN_INTERVAL_MINUTES=5
# SYNC_SCHEDULE_JITTER_MAX_SECONDS=30
# SYNC_SCHEDULE_FAILURE_AUTOPAUSE_THRESHOLD=0
# SYNC_SCHEDULE_BOOT_OVERDUE_GRACE_MINUTES=0

# --- Multiple API connections ---
# SYNC_USERNAME_COLLISION_POLICY=skip
# SYNC_ALL_CONCURRENCY=1
# SYNC_SOURCE_STALE_FACTOR=3

# --- Outbound HTTP proxy ---
# PROXY_CONNECT_TIMEOUT_MS=5000

# --- Automatic certificate rotation ---
# CERT_ROTATION_SCHEDULER_TICK_MS=3600000
# CERT_ROTATION_LEAD_DAYS=30
# CERT_ROTATION_OVERLAP_DAYS=7
# CERT_ROTATION_VALIDITY_DAYS=365
# CERT_ROTATION_NOTIFY_LEAD_DAYS=45
# CERT_ROTATION_JITTER_MAX_SECONDS=0
# CERT_ROTATION_BOOT_GRACE_HOURS=0
# CERT_ROTATION_FAILURE_AUTODISABLE_THRESHOLD=5
# CERT_ROTATION_DRY_RUN=false

# --- Brute-force protection ---
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_BASE_MS=900000
# LOGIN_LOCKOUT_MAX_MS=86400000
# LOGIN_LOCKOUT_RESPONSE_MODE=retry_after
# LOGIN_LOCKOUT_PRUNE_INTERVAL_MS=3600000
# ADMIN_LOGIN_RATE_LIMIT_MAX=10
# ADMIN_LOGIN_RATE_LIMIT_USERNAME_MAX=5
# SAML_SSO_RATE_IP_MAX=60
# SAML_SSO_RATE_WINDOW_MS=900000
# LOGIN_IP_BAN_THRESHOLD=10
# LOGIN_IP_BAN_MS=3600000
# RATE_LIMIT_TRUSTED_CIDRS=
# LOGIN_TARPIT_BASE_MS=0

# --- Back-channel (SOAP) SLO propagation ---
# SAML_BACKCHANNEL_LOGOUT_SCHEDULER_TICK_MS=30000
# SAML_BACKCHANNEL_LOGOUT_HTTP_TIMEOUT_MS=5000
# SAML_BACKCHANNEL_LOGOUT_MAX_RETRIES=5
# SAML_BACKCHANNEL_LOGOUT_CONCURRENCY=5
# SAML_BACKCHANNEL_LOGOUT_MAX_INFLIGHT=20
# SAML_BACKCHANNEL_LOGOUT_VALIDITY_S=300
