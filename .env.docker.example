SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32
# At-rest encryption key for the libSQL database file (required in production).
# Generate with `openssl rand -hex 32`. Alternatively mount a secret and set
# DATABASE_ENCRYPTION_KEY_FILE instead (do not set both).
DATABASE_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password-min-12-chars
IDP_BASE_URL=http://localhost:3000
TRUST_PROXY=false
AUDIT_RETENTION_DAYS=90
AUDIT_CLEANUP_INTERVAL_MS=86400000
ADMIN_USER_CREATE_RATE_LIMIT_MAX=5
ADMIN_USER_CREATE_RATE_LIMIT_WINDOW_MS=900000
MIGRATE_ONLY=0
# Scheduled-sync tuning (Prompt 32) — scheduling is opt-in per connection, off by default.
# Set SYNC_SCHEDULER_TICK_MS=0 to fully disable the in-process scheduler.
SYNC_SCHEDULER_TICK_MS=30000
SYNC_SCHEDULE_MIN_INTERVAL_MINUTES=5
SYNC_SCHEDULE_JITTER_MAX_SECONDS=30
SYNC_SCHEDULE_FAILURE_AUTOPAUSE_THRESHOLD=0
SYNC_SCHEDULE_BOOT_OVERDUE_GRACE_MINUTES=0

# Outbound HTTP proxy tuning (Prompt 33) — proxy is opt-in per connection, off by default.
# PROXY_CONNECT_TIMEOUT_MS=5000

# Automatic certificate rotation (Prompt 34) — opt-in per cert in the admin console, off by default.
# Set CERT_ROTATION_SCHEDULER_TICK_MS=0 to disable the auto-rotation scheduler (single-instance only).
# CERT_ROTATION_SCHEDULER_TICK_MS=3600000        # 0 disables the auto-rotation scheduler (manual only)
# CERT_ROTATION_LEAD_DAYS=30                      # auto-start when active cert expires within N days
# CERT_ROTATION_OVERLAP_DAYS=7                    # auto-complete after the pending cert has been published N days
# CERT_ROTATION_VALIDITY_DAYS=365                 # validity of auto-generated rotation certs
# CERT_ROTATION_NOTIFY_LEAD_DAYS=45               # "due soon" pre-notification lead
# CERT_ROTATION_JITTER_MAX_SECONDS=0              # random spread before auto-start; 0 = exact
# CERT_ROTATION_BOOT_GRACE_HOURS=0                # on boot, act immediately only if expiring within N hours
# CERT_ROTATION_FAILURE_AUTODISABLE_THRESHOLD=5   # auto-disable after N consecutive failures; 0 = never
# CERT_ROTATION_DRY_RUN=false                     # evaluate + audit without mutating
# Per-cert overrides: CERT_ROTATION_{SIGNING,ENCRYPTION}_{LEAD,OVERLAP}_DAYS
