# syntax=docker/dockerfile:1
# Development image: source bind-mount + Nest/Vite watch (see docker-compose.dev.yml).

# node:20-slim (glibc), not alpine — see Dockerfile: the libsql prebuilt that
# @prisma/adapter-libsql pulls is incompatible with current Alpine musl.
FROM node:20-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl wget && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

# Source is copied below; postinstall needs tsconfig + prisma — same pattern as production Dockerfile.
RUN pnpm install --ignore-scripts

COPY . .

# Build-time URL is only used by `prisma generate` (client codegen); the runtime
# URL/key come from docker-compose.dev.yml. No external DB is contacted.
ENV DATABASE_URL=file:/tmp/build.db

RUN pnpm --filter @nestidp/shared build \
	&& ./apps/api/node_modules/.bin/prisma generate --schema=./apps/api/prisma/schema.prisma

EXPOSE 3000 5173
ENTRYPOINT ["/app/scripts/docker-dev-entrypoint.sh"]
